   ================================---------- */

document.addEventListener('DOMContentLoaded', () => {
    // 1. Khởi tạo các thành phần giao diện
    initThemeSwitcher();
    initProjectModal();
    initContactForm();
    initSmoothScroll();
});

/**
 * 2. Tính năng chuyển đổi Sáng / Tối (Dark / Light Mode)
 */
function initThemeSwitcher() {
    const themeToggleBtn = document.getElementById('themeToggleBtn');
    
    // Kiểm tra lưu trữ trạng thái theme trước đó trong localStorage (nếu có)
    const savedTheme = localStorage.getItem('theme');
    if (savedTheme === 'dark') {
        document.documentElement.classList.add('dark');
    }

    if (themeToggleBtn) {
        themeToggleBtn.addEventListener('click', () => {
            document.documentElement.classList.toggle('dark');
            
            // Lưu trạng thái vào localStorage để ghi nhớ lựa chọn của người dùng
            if (document.documentElement.classList.contains('dark')) {
                localStorage.setItem('theme', 'dark');
            } else {
                localStorage.setItem('theme', 'light');
            }
        });
    }
}

/**
 * 3. Xử lý Popup xem chi tiết Dự án Cá nhân
 */
function initProjectModal() {
    // Các hàm mở và đóng modal được đưa ra phạm vi toàn cục (global) 
    // để có thể gọi trực tiếp từ thuộc tính onclick trong HTML.
    
    window.openModal = function(title, description) {
        const modal = document.getElementById('projectModal');
        const modalTitle = document.getElementById('modalTitle');
        const modalDesc = document.getElementById('modalDesc');

        if (modal && modalTitle && modalDesc) {
            modalTitle.innerText = title;
            modalDesc.innerText = description;
            modal.classList.remove('hidden');
            document.body.style.overflow = 'hidden'; // Khóa cuộn trang khi mở modal
        }
    };

    window.closeModal = function() {
        const modal = document.getElementById('projectModal');
        if (modal) {
            modal.classList.add('hidden');
            document.body.style.overflow = 'auto'; // Mở lại cuộn trang
        }
    };

    // Đóng modal khi bấm ra vùng nền mờ bên ngoài
    const modal = document.getElementById('projectModal');
    if (modal) {
        modal.addEventListener('click', (e) => {
            if (e.target === modal) {
                window.closeModal();
            }
        });
    }

    // Đóng modal khi nhấn phím ESC trên bàn phím
    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
            window.closeModal();
        }
    });
}

/**
 * 4. Xử lý gửi Form Liên hệ
 */
function initContactForm() {
    window.handleFormSubmit = function(event) {
        event.preventDefault(); // Ngăn chặn reload trang mặc định của form
        
        const alertBox = document.getElementById('formAlert');
        const contactForm = document.getElementById('contactForm');

        if (alertBox && contactForm) {
            // Hiển thị thông báo thành công
            alertBox.classList.remove('hidden');
            
            // Reset các ô nhập liệu trong form
            contactForm.reset();

            // Tự động ẩn thông báo sau 5 giây
            setTimeout(() => {
                alertBox.classList.add('hidden');
            }, 5000);
        }
    };
}

/**
 * 5. Tùy chỉnh hiệu ứng cuộn trang mượt mà (Smooth Scroll bổ sung)
 */
function initSmoothScroll() {
    const navLinks = document.querySelectorAll('nav a[href^="#"], a.scroll-link');
    
    navLinks.forEach(link => {
        link.addEventListener('click', function(e) {
            const targetId = this.getAttribute('href');
            if (targetId.startsWith('#') && targetId.length > 1) {
                e.preventDefault();
                const targetElement = document.querySelector(targetId);
                
                if (targetElement) {
                    targetElement.scrollIntoView({
                        behavior: 'smooth',
                        block: 'start'
                    });
                }
            }
        });
    });
}